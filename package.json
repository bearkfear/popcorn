{
  "name": "popcorn",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "generate": "bash scripts/generate.sh",
    "generate:check": "bash scripts/generate.sh --check",
    "catalog:generate": "bash scripts/generate-catalog.sh",
    "desktop:dev": "cd apps/desktop && bun --bun tauri dev",
    "desktop:build": "cd apps/desktop && bun --bun tauri build",
    "lint:server": "bun scripts/lint-server.ts && cargo fmt --manifest-path apps/server/Cargo.toml -p popcorn-server --check && CLIPPY_CONF_DIR=\"$PWD/apps/server\" cargo clippy -p popcorn-server --lib --bins -- -D warnings",
    "lint:desktop": "cd apps/desktop && bun run lint",
    "lint:desktop:fix": "cd apps/desktop && bun run lint:fix",
    "format:desktop": "cd apps/desktop && bun run format",
    "format:desktop:check": "cd apps/desktop && bun run format:check",
    "check:desktop": "bun run --filter @popcorn/desktop check",
    "check:sdk": "bun run --filter @popcorn/sdk check",
    "check:scripts": "tsc -p tsconfig.json",
    "typecheck": "bun run check:scripts && bun run check:sdk && bun run --filter @popcorn/desktop typecheck"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
