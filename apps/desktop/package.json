{
  "name": "@popcorn/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:sidecar": "bun ./scripts/prepare-sidecar.ts",
    "dev": "bun --bun vite",
    "check": "bun run typecheck && bun --bun biome check .",
    "typecheck": "bun --bun tsc -p tsconfig.json && bun --bun tsc -p tsconfig.tools.json && bun --bun tsc -p tsconfig.tests.json",
    "lint": "bun --bun biome lint .",
    "lint:fix": "bun --bun biome lint --write .",
    "format": "bun --bun biome format --write .",
    "format:check": "bun --bun biome format .",
    "build": "bun run check && bun --bun vite build",
    "preview": "bun --bun vite preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@popcorn/sdk": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@xstate/solid": "^2.0.0",
    "lucide-solid": "^1.58.0",
    "solid-js": "1.9.17",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  }
}
